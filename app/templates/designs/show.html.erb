<%= render "shared/title", text: "#{template.label} Design" %>

<section class="bit-page">
  <header class="bit-header">
    <ul class="bit-breadcrumbs">
      <li class="bit-breadcrumb"><%= link_to "Designs", routes.path(:designs), class: :link %></li>
      <li class="bit-breadcrumb"><%= template.label %></li>
    </ul>
  </header>

  <div class="bit-body">
    <div class="bit-card screen">
      <h2 class="label"><%= template.label %></h2>

      <div class="actions">
        <%= render "shared/actions/edit", path: routes.path(:design_edit, id: template.id) %>
      </div>

      <dl class="bit-definition-list">
        <dt class="key">Label</dt>
        <dd class="value"><%= template.label %></dd>

        <dt class="key">Name</dt>
        <dd class="value"><%= template.name %></dd>

        <dt class="key">Created</dt>
        <dd class="value"><%= human_at template.created_at %></dd>

        <dt class="key">Updated</dt>
        <dd class="value"><%= human_at template.updated_at %></dd>
      </dl>
    </div>
  </div>

  <%= scope(:tooltip_action_content, label: "Edit").render %>
  <%= render "screens/shared/popovers/all" %>
</section>

